# Copy to .env (make env-file does this). Never commit the real .env.
MYSQL_ROOT_PASSWORD=root_pass_change_me
MYSQL_DATABASE=telecomdb
MYSQL_USER=telecom_user
MYSQL_PASSWORD=telecom_pass_change_me

APP_PORT=8080
DB_POOL_SIZE=20
# Payload limits (relaxed binding of telecom.payload.*)
TELECOM_PAYLOAD_DEFAULT_MAX_REQUEST_SIZE=10MB
TELECOM_PAYLOAD_STREAMING_MAX_REQUEST_SIZE=500MB
TELECOM_PAYLOAD_MAX_DECOMPRESSED_SIZE=2GB
TELECOM_PAYLOAD_CHUNK_SIZE=1000
TELECOM_PAYLOAD_ASYNC_WORKERS=2
